# ==========================================
# SAHAYAK - Environment Configuration
# Emergency Assistance Web Application
# ==========================================

# -----------------
# Backend (FastAPI)
# -----------------
# Port for the FastAPI server (Render sets $PORT dynamically)
PORT=8000

# Database URL:
# SQLite (default for development): sqlite:///./sahayak.db
# PostgreSQL (for Render / Supabase / Neon): postgresql://user:password@hostname:5432/sahayak_db
DATABASE_URL=sqlite:///./sahayak.db

# JWT Secret Key - Change this in production to a strong 64-character random string
SECRET_KEY=sahayak-production-secure-jwt-secret-key-replace-with-openssl-rand-hex-32

# JWT Algorithm
ALGORITHM=HS256

# JWT Expiration in Minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated URLs, or * for all)
# Example for production: https://sahayak.vercel.app,https://your-domain.com
CORS_ORIGINS=*

# Environment mode: development | production
ENVIRONMENT=development

# ------------------
# Frontend (Vite)
# ------------------
# Backend API URL used by the frontend:
# In development: http://localhost:8000
# In production (e.g. on Vercel): https://sahayak-api.onrender.com
VITE_API_URL=http://localhost:8000
